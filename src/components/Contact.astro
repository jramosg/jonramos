---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { github, linkedin, mail } from '@/settings';
import ContactForm from './ContactForm.astro';
import LeafletMap from './LeafletMap.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
  {
    href: `mailto:${mail}`,
    label: t('contact.email'),
    value: mail,
  },
  {
    href: `https://github.com/${github}`,
    label: t('contact.github'),
    value: `@${github}`,
  },
  {
    href: `https://www.linkedin.com/in/${linkedin}`,
    label: t('contact.linkedin'),
    value: 'Jon Ramos',
  },
];
---

<section
  id="contact"
  class="section"
  aria-labelledby="contact-title"
  itemscope
  itemtype="https://schema.org/ContactPage"
>
  <div class="container">
    <header class="section-head">
      <h2 id="contact-title" class="heading">{t('contact.title')}</h2>
    </header>

    <div class="grid-layout">
      <address
        class="contact-info"
        itemscope
        itemtype="https://schema.org/Person"
      >
        <meta itemprop="name" content="Jon Ramos" />
        <p class="text" itemprop="description">{t('contact.text')}</p>

        <ul class="links">
          {links.map(({ href, label, value }) => <li>
            <span class="label">{label}</span>
            <a
              href={href}
              target={href.startsWith('http') ? '_blank' : undefined}
              rel={
                href.startsWith('http') ? 'noopener noreferrer me' : undefined
              }
              class="u-link"
              itemprop={href.startsWith('mailto') ? 'email' : 'sameAs'}
            >
              {value}
            </a>
          </li>)}
        </ul>

        <div
          class="visually-hidden"
          itemprop="address"
          itemscope
          itemtype="https://schema.org/PostalAddress"
        >
          <span itemprop="addressLocality">Urnieta</span>
          <span itemprop="addressRegion">Gipuzkoa</span>
          <span itemprop="addressCountry">ES</span>
        </div>
      </address>

      <div class="form-container">
        <h3 class="form-title">{t('contact.form.title')}</h3>
        <p class="form-description">{t('contact.form.description')}</p>
        <ContactForm />
      </div>
    </div>

    <div class="map-section" role="region" aria-label="Location map">
      <LeafletMap />
    </div>
  </div>
</section>

<style>
  .grid-layout {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(2rem, 6vw, 6rem);
    padding-top: 2rem;
    border-top: 2px solid var(--ink);
  }

  .text {
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 36ch;
  }

  .links {
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .links li {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    padding: 0.7rem 0;
    border-top: 1px solid var(--rule);
  }

  .label {
    color: var(--ink-subtle);
  }

  .links a {
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .form-title {
    font-size: var(--step-3);
    margin-bottom: 0.75rem;
  }

  .form-description {
    margin-bottom: 1.5rem;
  }

  .map-section {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  @media (max-width: 860px) {
    .grid-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
