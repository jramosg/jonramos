---
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import ContactForm from '@/components/ContactForm.astro';
import { localCopy, towns } from '@/data/localWeb';
import { localAlternates, localPath } from '@/data/localSlugs';
import { github, linkedin, location, mail } from '@/settings';
import type { Langs } from '@/i18n/ui';
import laguntzaImg from '@/assets/work/laguntza.jpg';
import besaideImg from '@/assets/work/besaide.jpg';
import jonImg from '@/assets/jonramos.webp';

interface Props {
  lang: Langs;
}

const { lang } = Astro.props;
const c = localCopy[lang];
const images = { laguntza: laguntzaImg, besaide: besaideImg };
const rotating = c.rotatingTowns;
const origin = (Astro.site ?? Astro.url).origin;
const pageUrl = `${origin}${localPath(lang)}`;
const words = (s: string) => s.trim().split(/\s+/).filter(Boolean);
const proofs = c.work.filter((w) => w.perfect);
const pageSpeed = (url: string) =>
  `https://pagespeed.web.dev/analysis?url=${encodeURIComponent(url)}`;

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${origin}/#web-design-gipuzkoa`,
  name: `Jon Ramos, ${c.serviceName}`,
  description: c.serviceDescription,
  url: pageUrl,
  image: `${origin}/og/local-${lang}.jpg`,
  email: mail,
  inLanguage: lang,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Urnieta',
    postalCode: '20130',
    addressRegion: 'Gipuzkoa',
    addressCountry: 'ES',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: location.lat,
    longitude: location.lng,
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
    ...towns.map((name) => ({ '@type': 'City', name })),
  ],
  availableLanguage: ['eu', 'es', 'en'],
  sameAs: [
    `https://github.com/${github}`,
    `https://www.linkedin.com/in/${linkedin}`,
  ],
  founder: { '@type': 'Person', '@id': `${origin}/#person`, name: 'Jon Ramos' },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faq.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<Layout
  title={c.metaTitle}
  description={c.metaDescription}
  alternates={localAlternates}
  xDefault="es"
  ogImage={`/og/local-${lang}.jpg`}
  ogImageAlt={c.h1.join(' ')}
  breadcrumb={[{ name: c.serviceName, path: localPath(lang) }]}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(serviceLd)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(faqLd)}
    /></Fragment>

  <!-- 1. Hero: the bay-blue wall -->
  <section class="hero on-wall" aria-labelledby="local-title">
    <div class="container hero-grid">
      <h1 id="local-title" class="h1">
        {c.h1.map((l) => <span>{l}</span>)}
      </h1>

      <p class="towns-line">
        <span class="towns-lead">{c.townsLead}</span>
        <span class="town-slot" aria-hidden="true">
          <span class="town" data-town={JSON.stringify(rotating)}
            >{rotating[0]}</span
          >
        </span>
        <span class="visually-hidden">{towns.join(', ')}</span>
      </p>

      <div class="hero-foot">
        <p class="lede">{c.lede}</p>
        <div class="ctas">
          <a href="#kontaktua" class="btn btn-paint">{c.ctaPrimary}</a>
          <a href="#lanak" class="btn btn-on-wall">{c.ctaSecondary}</a>
        </div>
      </div>
    </div>
    <div class="sand-line" aria-hidden="true"></div>
  </section>

  <!-- 2. Who: a few sentences that ink in as you scroll past, next
       to the person saying them -->
  <section class="about container">
    <div>
      <p class="statement" data-statement>
        {words(c.about).map((w) => (
          <> <span class="w">{w}</span>{' '} </>
        ))}
      </p>
      <a href={`/${lang}`} class="u-link about-link">{c.aboutLink}</a>
    </div>
    <figure class="portrait">
      <Image
        src={jonImg}
        alt="Jon Ramos"
        widths={[360, 540, 760]}
        sizes="(max-width: 860px) 62vw, 22rem"
        loading="lazy"
      />
    </figure>
  </section>

  <!-- 3. Real work -->
  <section
    id="lanak"
    class="section container work"
    aria-labelledby="work-title"
  >
    <h2 id="work-title" class="h2">{c.workTitle}</h2>
    <ul class="work-list">
      {c.work.map((w) => <li class="work-item">
        <a
          href={w.href}
          target="_blank"
          rel="noopener noreferrer"
          class="shot"
          tabindex="-1"
          aria-hidden="true"
        >
          <Image
            src={images[w.image]}
            alt={`${w.name}, ${w.place}`}
            widths={[480, 760, 1100]}
            sizes="(max-width: 860px) 100vw, 58vw"
            loading="lazy"
          />
        </a>
        <div class="work-text">
          <h3>{w.name}</h3>
          <p class="place">{w.place}</p>
          <p>{w.body}</p>
          <a
            href={w.href}
            target="_blank"
            rel="noopener noreferrer"
            class="u-link"
          >
            {c.workVisit}
          </a>
        </div>
      </li>)}
    </ul>
  </section>

  <!-- 4. Speed: the one number that matters -->
  <section class="speed container" aria-labelledby="speed-title">
    <p class="hundred" aria-hidden="true">100</p>
    <div>
      <h2 id="speed-title" class="h2">{c.speedTitle}</h2>
      <p class="speed-body">{c.speedBody}</p>
      <p class="speed-proof">
        {c.speedProof}{' '}
        {proofs.map((w, i) => (
          <>
            {i > 0 && ', '}
            <a
              href={pageSpeed(w.href)}
              target="_blank"
              rel="noopener noreferrer"
              class="u-link"
            >
              {w.name}
            </a>
          </>
        ))}
      </p>

      <form
        class="test"
        data-test
        data-loading={c.test.loading}
        data-invalid={c.test.invalid}
        data-busy={c.test.busy}
        data-verdicts={JSON.stringify(c.test.verdicts)}
        data-message={c.test.message}
      >
        <label for="test-url">{c.test.label}</label>
        <div class="test-row">
          <input
            id="test-url"
            type="text"
            inputmode="url"
            autocapitalize="off"
            autocomplete="url"
            spellcheck="false"
            placeholder={c.test.placeholder}
            required
          />
          <button type="submit" class="btn btn-paint">{c.test.button}</button>
        </div>
        <p class="test-status" role="status" aria-live="polite" data-status></p>
      </form>
    </div>

    <div class="result" data-result hidden>
      <p class="result-num" data-num>0</p>
      <div>
        <p class="result-label">
          {c.test.resultLabel}: <span data-host></span>
        </p>
        <p class="result-verdict" data-verdict></p>
        <a href="#kontaktua" class="btn btn-paint" data-cta>{c.test.cta}</a>
      </div>
    </div>
  </section>

  <!-- 5. The process, painted along the wall like frontón squares.
       Scrolls sideways on wide screens (GSAP, loaded on approach);
       a plain stack everywhere else. -->
  <section class="wall" aria-labelledby="steps-title" data-wall>
    <div class="wall-inner">
      <h2 id="steps-title" class="h2 wall-title">{c.stepsTitle}</h2>
      <ol class="track">
        {c.steps.map((step, i) => <li class="cuadro">
          <span class="num" aria-hidden="true">
            {i + 1}
          </span>
          <div class="cuadro-text">
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        </li>)}
      </ol>
    </div>
  </section>

  <!-- 6. What's included -->
  <section class="section container includes" aria-labelledby="inc-title">
    <h2 id="inc-title" class="h2">{c.includesTitle}</h2>
    <ul class="inc-list">
      {c.includes.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <!-- 7. Where -->
  <section class="section towns" aria-labelledby="towns-title">
    <div class="container towns-grid">
      <div>
        <h2 id="towns-title" class="h2">{c.townsTitle}</h2>
        <p class="towns-body">{c.townsBody}</p>
      </div>
      <ul class="town-list">
        {towns.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </section>

  <!-- 8. FAQ -->
  <section class="section container faq" aria-labelledby="faq-title">
    <h2 id="faq-title" class="h2">{c.faqTitle}</h2>
    <div class="faq-list">
      {c.faq.map(({ q, a }) => <details>
        <summary>{q}</summary>
        <p>{a}</p>
      </details>)}
    </div>
  </section>

  <!-- 9. Contact -->
  <section id="kontaktua" class="contact" aria-labelledby="lc-title">
    <div class="container contact-grid">
      <div>
        <h2 id="lc-title" class="h2">{c.contactTitle}</h2>
        <p class="contact-body">{c.contactBody}</p>
        <p class="contact-mail">
          {c.contactOr}{' '}
          <a href={`mailto:${mail}`} class="u-link">{mail}</a>
        </p>
      </div>
      <ContactForm />
    </div>
  </section>

  <!-- The prompt that follows you down the page: one line about the
       business, carried into the contact form. -->
  <form class="dock" data-dock>
    <label for="dock-input" class="visually-hidden">{c.barLabel}</label>
    <input
      id="dock-input"
      type="text"
      placeholder={c.barPlaceholder}
      autocomplete="off"
      enterkeyhint="go"
    />
    <button type="submit">{c.barButton}</button>
  </form>
</Layout>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Town names rotate under the headline. */
  const town = document.querySelector<HTMLElement>('[data-town]');
  if (town && !reduce && town.dataset.town) {
    const names: string[] = JSON.parse(town.dataset.town ?? '[]');
    let i = 0;
    setInterval(() => {
      if (document.hidden) return;
      i = (i + 1) % names.length;
      town.classList.remove('in');
      void town.offsetWidth;
      town.textContent = names[i];
      town.classList.add('in');
    }, 1900);
  }

  /* The sentence inks in word by word with the scroll, and the prompt
     bar docks once the hero is gone and leaves at the contact form. */
  const statement = document.querySelector<HTMLElement>('[data-statement]');
  const inkWords = statement
    ? [...statement.querySelectorAll<HTMLElement>('.w')]
    : [];
  const dock = document.querySelector<HTMLFormElement>('[data-dock]');
  const hero = document.querySelector<HTMLElement>('.hero');
  const contact = document.getElementById('kontaktua');
  const scoreBox = document.querySelector<HTMLElement>('[data-result]');
  if (statement && !reduce) statement.classList.add('is-live');

  let inked = -1;
  let ticking = false;
  const update = () => {
    ticking = false;
    const vh = innerHeight;
    if (statement && !reduce) {
      const r = statement.getBoundingClientRect();
      const p = (vh * 0.85 - r.top) / (r.height + vh * 0.25);
      const n = Math.round(Math.min(1, Math.max(0, p)) * inkWords.length);
      if (n !== inked) {
        inkWords.forEach((w, i) => w.classList.toggle('on', i < n));
        inked = n;
      }
    }
    if (dock && hero && contact) {
      // the measured score has its own button; don't sit on top of it
      const score = scoreBox?.hidden ? null : scoreBox?.getBoundingClientRect();
      const onScore = !!score && score.top < vh && score.bottom > 0;
      const show =
        !onScore &&
        hero.getBoundingClientRect().bottom < 0 &&
        contact.getBoundingClientRect().top > vh * 0.75;
      dock.classList.toggle('is-shown', show);
      dock.inert = !show;
    }
  };
  addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    },
    { passive: true },
  );
  addEventListener('resize', update);
  update();

  /* Put a line at the top of the contact form's message, once. */
  const carryToForm = (text: string | undefined) => {
    const message = document.querySelector<HTMLTextAreaElement>('#message');
    if (!text || !message || message.value.includes(text)) return;
    message.value = message.value ? `${text}\n${message.value}` : text;
  };

  dock?.addEventListener('submit', (e) => {
    e.preventDefault();
    const input = dock.querySelector('input');
    carryToForm(input?.value.trim());
    if (input) input.value = '';
    contact?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' });
    document.getElementById('name')?.focus({ preventScroll: true });
  });

  /* Measure the visitor's current site and stand its score next to
     the 100. The number is carried into the contact form. */
  const test = document.querySelector<HTMLFormElement>('[data-test]');
  const result = document.querySelector<HTMLElement>('[data-result]');
  if (test && result) {
    const field = test.querySelector<HTMLInputElement>('input')!;
    const button = test.querySelector<HTMLButtonElement>('button')!;
    const status = test.querySelector<HTMLElement>('[data-status]')!;
    const num = result.querySelector<HTMLElement>('[data-num]')!;
    const host = result.querySelector<HTMLElement>('[data-host]')!;
    const verdict = result.querySelector<HTMLElement>('[data-verdict]')!;
    const cta = result.querySelector<HTMLAnchorElement>('[data-cta]')!;
    const verdicts: string[] = JSON.parse(test.dataset.verdicts ?? '[]');
    let note = '';

    const countTo = (target: number) => {
      if (reduce) {
        num.textContent = String(target);
        return;
      }
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / 900);
        num.textContent = String(Math.round(target * (1 - (1 - t) ** 3)));
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    test.addEventListener('submit', async (e) => {
      e.preventDefault();
      button.disabled = true;
      test.classList.add('is-busy');
      status.textContent = test.dataset.loading ?? '';
      try {
        const res = await fetch('/api/speed', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url: field.value }),
        });
        const data = await res.json();
        if (!res.ok) {
          status.textContent =
            (data.error === 'invalid'
              ? test.dataset.invalid
              : test.dataset.busy) ?? '';
          return;
        }
        status.textContent = '';
        host.textContent = data.host;
        verdict.textContent =
          verdicts[data.score < 50 ? 0 : data.score < 90 ? 1 : 2] ?? '';
        note = (test.dataset.message ?? '')
          .replace('{url}', data.host)
          .replace('{score}', String(data.score));
        result.hidden = false;
        countTo(data.score);
        update();
        result.scrollIntoView({
          behavior: reduce ? 'auto' : 'smooth',
          block: 'center',
        });
      } catch {
        status.textContent = test.dataset.busy ?? '';
      } finally {
        button.disabled = false;
        test.classList.remove('is-busy');
      }
    });

    cta.addEventListener('click', () => carryToForm(note));
  }

  /* Pin the process wall and walk sideways along it. GSAP is only
     fetched when the wall is close, so it never costs the first load. */
  const wall = document.querySelector<HTMLElement>('[data-wall]');
  const wide = matchMedia('(min-width: 900px)').matches;
  if (wall && wide && !reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      async (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        const [{ gsap }, { ScrollTrigger }] = await Promise.all([
          import('gsap'),
          import('gsap/ScrollTrigger'),
        ]);
        gsap.registerPlugin(ScrollTrigger);
        const track = wall.querySelector<HTMLElement>('.track');
        if (!track) return;
        wall.classList.add('is-pinned');
        const distance = () =>
          Math.max(0, track.scrollWidth - wall.clientWidth);

        const walk = gsap.to(track, {
          x: () => -distance(),
          ease: 'none',
          scrollTrigger: {
            trigger: wall,
            start: 'top top+=64',
            end: () => `+=${distance()}`,
            pin: true,
            scrub: 0.5,
            invalidateOnRefresh: true,
          },
        });

        // numerals drift a little slower than the wall, like paint on
        // a surface you walk past
        track.querySelectorAll<HTMLElement>('.num').forEach((num) => {
          gsap.fromTo(
            num,
            { xPercent: 12 },
            {
              xPercent: -6,
              ease: 'none',
              scrollTrigger: {
                trigger: num.parentElement,
                containerAnimation: walk,
                start: 'left right',
                end: 'right left',
                scrub: true,
              },
            },
          );
        });
        ScrollTrigger.refresh();
      },
      { rootMargin: '800px 0px' },
    );
    io.observe(wall);
  }
</script>

<style>
  .h2 {
    font-size: var(--step-4);
    line-height: 0.92;
  }

  /* this page stacks many short sections; the site-wide rhythm leaves
     too much air between them */
  .section {
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }

  /* ---------- 1. hero ---------- */
  .hero {
    background: var(--wall);
    color: var(--on-wall);
  }

  .hero-grid {
    padding-top: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .h1 {
    display: grid;
    /* capped by height too, so the lede and buttons stay on the
       first screen of a laptop */
    font-size: clamp(3.4rem, min(12.5vw, 16.5svh), 11rem);
    font-weight: 900;
    line-height: 0.84;
    color: var(--on-wall);
  }

  .towns-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.35em;
    margin: clamp(1rem, 2.5vw, 1.5rem) 0 0;
    font-size: clamp(1.8rem, min(5.5vw, 7.5svh), 4.6rem);
    font-weight: 800;
    font-stretch: var(--cond);
    line-height: 1;
    color: var(--on-wall-muted);
  }

  .town-slot {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.08em;
    vertical-align: bottom;
  }

  .town {
    display: inline-block;
    color: var(--paint);
  }

  .town:global(.in) {
    animation: town-in 520ms var(--ease) both;
  }

  @keyframes town-in {
    from {
      transform: translateY(100%);
    }
  }

  .hero-foot {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) auto;
    align-items: end;
    gap: 1.5rem 3rem;
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  .lede {
    margin: 0;
    max-width: 46ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--on-wall-muted);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .sand-line {
    height: 10px;
    background: var(--paint);
  }

  /* ---------- 2. about ---------- */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(15rem, 26vw, 22rem);
    align-items: start;
    gap: 2.5rem clamp(2rem, 5vw, 5rem);
    padding-top: clamp(4rem, 9vw, 7rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .statement {
    margin: 0;
    max-width: 27ch;
    font-size: clamp(2.1rem, 5.2vw, 4.6rem);
    font-weight: 850;
    font-stretch: var(--cond);
    line-height: 0.98;
    color: var(--ink);
    text-wrap: balance;
  }

  .statement.is-live .w {
    opacity: 0.16;
    transition: opacity 320ms var(--ease);
  }

  .statement.is-live .w.on {
    opacity: 1;
  }

  .portrait {
    isolation: isolate;
    margin: 0 1rem 1rem 0;
    /* stays beside the sentence while it inks in */
    position: sticky;
    top: calc(var(--nav-height) + 2rem);
  }

  /* a block of sand paint behind the photo, off by a brush width */
  .portrait::before {
    content: '';
    position: absolute;
    inset: 1rem -1rem -1rem 1rem;
    z-index: -1;
    background: var(--paint);
  }

  .portrait img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 0;
    border: 3px solid var(--ink);
  }

  .about-link {
    display: inline-block;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    font-size: var(--step-1);
    font-weight: 650;
  }

  /* ---------- 4. speed ---------- */
  .speed {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 5vw, 5rem);
    padding-top: clamp(4rem, 9vw, 7rem);
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }

  .hundred {
    margin: 0;
    font-size: clamp(8rem, 26vw, 22rem);
    font-weight: 900;
    font-stretch: var(--cond);
    line-height: 0.78;
    color: var(--wall);
  }

  :global([data-theme='dark']) .hundred {
    color: var(--paint);
  }

  .speed-body {
    margin: 1.25rem 0 0;
    max-width: 48ch;
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .speed-proof {
    margin: 1.25rem 0 0;
    font-weight: 650;
  }

  .test {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 2px solid var(--ink);
    max-width: 34rem;
  }

  .test label {
    display: block;
    margin-bottom: 0.6rem;
    font-size: var(--step-2);
    font-weight: 850;
    font-stretch: var(--cond);
    line-height: 1;
    color: var(--ink);
  }

  .test-row {
    display: flex;
    border: 3px solid var(--ink);
    background: var(--ground-raised);
  }

  .test-row input {
    flex: 1;
    min-width: 0;
    padding: 0.8rem 1rem;
    font: inherit;
    font-size: var(--step-1);
    color: var(--ink);
    background: transparent;
    border: 0;
  }

  .test-row input:focus {
    outline: none;
  }

  .test-row:focus-within {
    border-color: var(--line);
  }

  .test-row .btn {
    border: 0;
    border-left: 3px solid var(--ink);
