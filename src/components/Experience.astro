---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const highlights = [
  t('experience.highlight1'),
  t('experience.highlight2'),
  t('experience.highlight3'),
];
---

<section id="experience" class="section" aria-labelledby="experience-title">
  <div class="container">
    <header class="section-head">
      <h2 id="experience-title" class="heading">
        {t('experience.title')}
      </h2>
    </header>

    <article
      class="entry"
      itemscope
      itemtype="https://schema.org/OrganizationRole"
    >
      <p class="years">
        <time datetime="2016-09" itemprop="startDate">2016</time>
        <span class="now">{t('experience.present')}</span>
      </p>

      <div class="body">
        <h3 class="role" itemprop="roleName">
          {t('experience.role')},{' '}
          <a
            href="https://ubikare.io/"
            target="_blank"
            rel="noopener noreferrer"
            class="company"
            itemprop="memberOf"
            itemscope
            itemtype="https://schema.org/Organization"
            ><span itemprop="name">Ubikare</span>
            <meta itemprop="url" content="https://ubikare.io/"
          /></a>
        </h3>

        <p class="description" itemprop="description">
          {t('experience.ubikare_desc')}
        </p>

        <ul class="highlights">
          {highlights.map((h) => <li>{h}</li>)}
        </ul>

        <p class="stack">Clojure, ClojureScript, Datomic</p>
      </div>
    </article>
  </div>
</section>

<style>
  .entry {
    display: grid;
    grid-template-columns: minmax(10rem, 0.8fr) 2fr;
    gap: clamp(1.5rem, 5vw, 5rem);
    padding-top: 2rem;
    border-top: 2px solid var(--ink);
  }

  .years {
    margin: 0;
    display: grid;
    align-content: start;
    font-size: clamp(4rem, 10vw, 8rem);
    font-weight: 900;
    font-stretch: var(--cond);
    line-height: 0.85;
    color: var(--wall);
  }

  :global([data-theme='dark']) .years {
    color: var(--link);
  }

  .now {
    font-size: 0.4em;
    color: var(--ink-subtle);
  }

  .role {
    font-size: var(--step-3);
    margin-bottom: 1.25rem;
  }

  .company {
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.12em;
  }

  .company:hover {
    text-decoration-color: var(--ink);
  }

  .description {
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: var(--measure);
  }

  .highlights {
    margin: 1.5rem 0;
    padding: 0;
    list-style: none;
    max-width: var(--measure);
  }

  .highlights li {
    position: relative;
    padding: 0.7rem 0 0.7rem 1.6rem;
    border-top: 1px solid var(--rule);
    color: var(--ink);
  }

  .highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.35rem;
    width: 0.9rem;
    height: 3px;
    background: var(--line);
  }

  .stack {
    margin: 0;
    font-weight: 600;
    color: var(--ink-subtle);
  }

  @media (max-width: 760px) {
    .entry {
      grid-template-columns: 1fr;
    }

    .years {
      display: flex;
      align-items: baseline;
      gap: 1rem;
    }
  }
</style>
