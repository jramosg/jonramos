---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const highlights = [
  t('experience.highlight1'),
  t('experience.highlight2'),
  t('experience.highlight3'),
];
---

<section id="experience" class="section" aria-labelledby="experience-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <p class="kicker">
        <span class="no">01</span> · {t('experience.title')}
      </p>
      <div class="heading-row">
        <h2 id="experience-title" class="heading">
          {t('experience.title')}
        </h2>
      </div>
    </header>

    <div
      class="entry"
      itemscope
      itemtype="https://schema.org/OrganizationRole"
      data-reveal
    >
      <div class="entry-meta">
        <time datetime="2016-09" class="entry-date" itemprop="startDate">
          2016 —
        </time>
        <span class="status-badge">
          <span class="status-dot"></span>
          {t('experience.present')}
        </span>
        <span class="entry-duration" aria-hidden="true">
          {new Date().getFullYear() - 2016}+ yrs
        </span>
      </div>

      <div class="entry-body">
        <h3 class="role" itemprop="roleName">{t('experience.role')}</h3>

        <a
          href="https://ubikare.io/"
          target="_blank"
          rel="noopener noreferrer"
          class="company"
          itemprop="memberOf"
          itemscope
          itemtype="https://schema.org/Organization"
          aria-label="Ubikare company website (opens in new tab)"
        >
          <span class="company-at">@</span>
          <span itemprop="name">Ubikare</span>
          <svg
            class="company-arrow"
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
          <meta itemprop="url" content="https://ubikare.io/" />
        </a>

        <p class="description" itemprop="description">
          {t('experience.ubikare_desc')}
        </p>

        <ul class="highlights">
          {
            highlights.map((highlight) => (
              <li class="highlight-item">
                <span class="highlight-marker" aria-hidden="true">
                  =&gt;
                </span>
                {highlight}
              </li>
            ))
          }
        </ul>

        <ul class="tags" aria-label="Technologies used">
          <li><span>Clojure</span></li>
          <li><span>ClojureScript</span></li>
          <li><span>Datomic</span></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .section {
    padding: 7rem 0;
  }

  .entry {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 2.5rem;
    max-width: 880px;
    position: relative;
    padding: 2.25rem 0 0;
    border-top: 1px solid var(--hairline);
  }

  /* a short teal segment over the hairline marks the active entry */
  .entry::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 72px;
    height: 2px;
    background: var(--accent);
  }

  .entry-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .entry-date {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    color: var(--text-strong);
    font-variant-numeric: tabular-nums;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid var(--accent-line);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 50%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .status-dot {
      animation: pulse 2.4s ease-in-out infinite;
    }
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  .entry-duration {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-faint);
  }

  .entry-body {
    min-width: 0;
  }

  .role {
    font-size: var(--text-xl);
    margin-bottom: 0.4rem;
  }

  .company {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-base);
    color: var(--haze);
    margin-bottom: 1.25rem;
    transition: color var(--dur-base) var(--ease-out-expo);
  }

  .company-at {
    color: var(--text-subtle);
  }

  .company-arrow {
    opacity: 0;
    transform: translateX(-4px);
    transition: all var(--dur-base) var(--ease-out-expo);
  }

  .company:hover {
    color: var(--text-strong);
  }

  .company:hover .company-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .description {
    font-size: var(--text-base);
    color: var(--text-muted);
    margin: 0 0 1.5rem;
    max-width: 60ch;
  }

  .highlights {
    list-style: none;
    margin: 0 0 1.75rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .highlight-item {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    color: var(--text-muted);
    font-size: var(--text-base);
    line-height: var(--leading-snug);
  }

  .highlight-marker {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
    flex-shrink: 0;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    list-style: none;
    padding: 1.25rem 0 0;
    margin: 0;
    border-top: 1px solid var(--hairline);
  }

  .tags li {
    display: contents;
  }

  .tags span {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: 0.25rem 0.625rem;
    background: var(--surface-inset);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-xs);
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .section {
      padding: 4.5rem 0;
    }

    .entry {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .entry-meta {
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }
  }
</style>
