---
import LanguagePicker from './LanguagePicker.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import ThemeSwitcher from './theme-switcher/ThemeSwitcher.astro';
import { getNavigationUrl } from '@/utils/navigation';
import { localPath } from '@/data/localSlugs';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// `spy` links point at sections of the home page and light up while
// that section is in view; the others are routes matched by path.
const links = [
  {
    id: 'experience',
    name: t('nav.work'),
    href: getNavigationUrl(lang, '#experience'),
    spy: true,
  },
  {
    id: 'projects',
    name: t('nav.projects'),
    href: getNavigationUrl(lang, '#projects'),
    spy: true,
  },
  {
    id: 'contributions',
    name: t('nav.contributions'),
    href: `/${lang}/contributions`,
    spy: false,
  },
  {
    id: 'contact',
    name: t('nav.contact'),
    href: getNavigationUrl(lang, '#contact'),
    spy: true,
  },
];

const local = { name: t('nav.local'), href: localPath(lang) };

const trim = (p: string) => p.replace(/\/+$/, '');
const here = trim(Astro.url.pathname);
const onPage = (href: string) => here === trim(href);
const onHome = here === `/${lang}`;
---

<header class="header" role="banner">
  <nav class="bar" aria-label="Main navigation">
    <a href={`/${lang}`} class="wordmark" aria-label="Jon Ramos, home">
      Jon Ramos
    </a>

    <ul class="links">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              data-section={link.spy && onHome ? link.id : undefined}
              aria-current={!link.spy && onPage(link.href) ? 'page' : undefined}
            >
              {link.name}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={local.href}
          class="local"
          aria-current={onPage(local.href) ? 'page' : undefined}
        >
          {local.name}
        </a>
      </li>
    </ul>

    <div class="tools">
      <LanguagePicker />
      <ThemeSwitcher />
    </div>

    <button
      class="menu-btn"
      id="menuBtn"
      aria-expanded="false"
      aria-controls="drawer"
    >
      <span class="menu-label">Menu</span>
    </button>
  </nav>

  <div class="drawer" id="drawer" aria-hidden="true">
    <ul class="drawer-links">
      <li>
        <a href={local.href} class="drawer-link local" tabindex="-1">
          {local.name}
        </a>
      </li>
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="drawer-link" tabindex="-1">
              {link.name}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="drawer-tools">
      <LanguagePicker />
      <ThemeSwitcher id="theme-toggle-mobile" />
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const menuBtn = document.getElementById('menuBtn');
    const drawer = document.getElementById('drawer');
    const drawerLinks = document.querySelectorAll('.drawer-link');

    function toggleDrawer() {
      const isOpen = drawer?.classList.contains('open');

      if (isOpen) {
        drawer?.classList.remove('open');
        menuBtn?.classList.remove('open');
        menuBtn?.setAttribute('aria-expanded', 'false');
        drawer?.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        drawerLinks.forEach((link) => {
          link.setAttribute('tabindex', '-1');
        });
      } else {
        drawer?.classList.add('open');
        menuBtn?.classList.add('open');
        menuBtn?.setAttribute('aria-expanded', 'true');
        drawer?.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        drawerLinks.forEach((link) => {
          link.setAttribute('tabindex', '0');
        });
      }
    }

    if (menuBtn) {
      menuBtn.addEventListener('click', toggleDrawer);
    }

    drawerLinks.forEach((link) => {
      link.addEventListener('click', toggleDrawer);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer?.classList.contains('open')) {
        toggleDrawer();
        menuBtn?.focus();
      }
    });

    // Scroll-spy: flag the nav link whose section is currently in view.
    const spyLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('a[data-section]'),
    );
    const sections = spyLinks
      .map((link) => document.getElementById(link.dataset.section ?? ''))
      .filter((el): el is HTMLElement => el !== null);

    if (sections.length > 0) {
      const navHeight =
        parseInt(
          getComputedStyle(document.documentElement).getPropertyValue(
            '--nav-height',
          ),
        ) || 72;

      let ticking = false;
      const updateActive = () => {
        ticking = false;
        const line = window.scrollY + navHeight + 48;
        let current = '';
        for (const section of sections) {
          if (section.offsetTop <= line) current = section.id;
        }
        // Near the bottom of the page, force the last section active so
        // short trailing sections (e.g. contact) still light up.
        if (
          window.innerHeight + window.scrollY >=
          document.body.offsetHeight - 2
        ) {
          current = sections[sections.length - 1].id;
        }
        spyLinks.forEach((link) =>
          link.classList.toggle('is-active', link.dataset.section === current),
        );
      };

      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(updateActive);
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      updateActive();
    }
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--ground);
    border-bottom: 1px solid var(--rule);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: var(--nav-height);
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .wordmark {
    font-size: 1.5rem;
    font-weight: 850;
    font-stretch: var(--cond);
    line-height: 1;
    color: var(--ink);
    white-space: nowrap;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    margin: 0 0 0 auto;
    padding: 0;
    list-style: none;
  }

  .links a {
    position: relative;
    display: block;
    padding: 0.4rem 0;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink-muted);
    transition: color 160ms var(--ease);
  }

  .links a:hover,
  .links a.is-active,
  .links a[aria-current='page'] {
    color: var(--ink);
  }

  .links a.is-active::after,
  .links a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--ink);
  }

  /* the one link for local businesses is painted, not underlined */
  .links a.local {
    padding: 0.45rem 0.85rem;
    background: var(--paint);
    color: var(--on-paint);
    font-weight: 650;
    border-radius: 2px;
  }

  .links a.local:hover {
    background: var(--ink);
    color: var(--ground);
  }

  .links a.local::after {
    display: none;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .menu-btn {
    display: none;
    margin-left: auto;
    padding: 0.5rem 0.9rem;
    border: 2px solid var(--ink);
    border-radius: 2px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .menu-btn.open {
    background: var(--ink);
    color: var(--ground);
  }

  .drawer {
    display: none;
  }

  @media (max-width: 960px) {
    .links,
    .tools {
      display: none;
    }

    .menu-btn {
      display: block;
    }

    .drawer {
      display: block;
      position: fixed;
      inset: var(--nav-height) 0 0 0;
      padding: 2rem var(--gutter);
      background: var(--wall);
      color: var(--on-wall);
      transform: translateY(-110%);
      visibility: hidden;
      transition:
        transform 380ms var(--ease),
        visibility 0s 380ms;
      overflow-y: auto;
    }

    .drawer.open {
      transform: none;
      visibility: visible;
      transition: transform 380ms var(--ease);
    }

    .drawer-links {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .drawer-link {
      display: block;
      padding: 0.35rem 0;
      font-size: clamp(2.6rem, 12vw, 4rem);
      font-weight: 850;
      font-stretch: var(--cond);
      line-height: 1;
      color: var(--on-wall);
    }

    .drawer-link.local {
      color: var(--paint);
    }

    .drawer-tools {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid rgba(242, 244, 239, 0.25);
      --ink: var(--on-wall);
      --ink-muted: var(--on-wall-muted);
    }
  }
</style>
