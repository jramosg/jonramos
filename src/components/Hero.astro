---
import { Image } from 'astro:assets';
import jonRamosImg from '../assets/jonramos.webp';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { getNavigationUrl } from '@/utils/navigation';
import { localPath } from '@/data/localSlugs';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  id="home"
  class="hero"
  aria-labelledby="hero-title"
  itemscope
  itemtype="https://schema.org/Person"
>
  <div class="wall">
    <div class="container wall-grid">
      <h1 id="hero-title" class="name" itemprop="name">
        <span class="line"><span>Jon</span></span>
        <span class="line"><span>Ramos</span></span>
      </h1>

      <div class="intro">
        <p class="role" itemprop="jobTitle">{t('hero.title')}</p>
        <p class="lede" itemprop="description">
          {t('hero.description')}{' '}
          <a
            href="https://ubikare.io/"
            target="_blank"
            rel="noopener noreferrer"
            itemprop="worksFor"
            itemscope
            itemtype="https://schema.org/Organization"
            ><span itemprop="name">Ubikare</span></a
          >{t('hero.descAfter')}
        </p>
      </div>

      <figure class="portrait">
        <Image
          src={jonRamosImg}
          alt="Jon Ramos"
          width={400}
          height={533}
          widths={[260, 320, 400, 520, 640]}
          sizes="(max-width: 760px) 46vw, 340px"
          loading="eager"
          fetchpriority="high"
          itemprop="image"
        />
      </figure>
    </div>
    <div class="marra" aria-hidden="true"></div>

    <meta itemprop="url" content="https://jonramos.dev" />
    <span
      itemprop="address"
      itemscope
      itemtype="https://schema.org/PostalAddress"
      class="visually-hidden"
    >
      <meta itemprop="addressLocality" content="Urnieta" />
      <meta itemprop="addressRegion" content="Gipuzkoa" />
      <meta itemprop="addressCountry" content="ES" />
    </span>
  </div>

  <div class="container doors">
    <a href={localPath(lang)} class="door door-local">
      {t('hero.doorLocal')}
    </a>
    <a href={getNavigationUrl(lang, '#experience')} class="door door-tech">
      {t('hero.doorTech')}
    </a>
  </div>

  <div class="container">
    <div class="repl">
      <p class="repl-hint">{t('hero.replHint')}</p>
      <p class="repl-line" aria-hidden="true">
        <span class="repl-prompt">user=&gt;</span>
        <span class="repl-expr">(def jon (software-engineer))</span>
      </p>
      <p class="repl-line repl-result" aria-hidden="true">#'user/jon</p>
      <div class="repl-history" id="repl-history" aria-live="polite"></div>
      <p class="repl-line repl-input-line">
        <span class="repl-prompt" aria-hidden="true">user=&gt;</span>
        <input
          id="repl-input"
          class="repl-input"
          type="text"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          enterkeyhint="send"
          maxlength="140"
          placeholder="(help)"
          aria-label="Clojure REPL. Type (help) and press Enter."
        />
      </p>
    </div>
  </div>
</section>

<script>
  import { setTheme } from './theme-switcher/theme';
  import { loadSci, type SciEval } from './repl/sci';

  /* ------------------------------------------------------------------ */
  /* A tiny Clojure: enough of a reader + evaluator that the hero REPL   */
  /* is real. (def jon (software-engineer)) genuinely evaluates.         */
  /* ------------------------------------------------------------------ */

  class Kw {
    name: string;
    constructor(name: string) {
      this.name = name;
    }
  }

  class Sym {
    name: string;
    constructor(name: string) {
      this.name = name;
    }
  }

  class Vec {
    items: Value[];
    constructor(items: Value[]) {
      this.items = items;
    }
  }

  /* printed verbatim — for record-style literals and help text */
  class Raw {
    s: string;
    constructor(s: string) {
      this.s = s;
    }
  }

  type Value =
    | number
    | string
    | boolean
    | null
    | Kw
    | Sym
    | Vec
    | Raw
    | Value[]
    | ((...args: Value[]) => Value);

  function tokenize(src: string): string[] {
    const tokens: string[] = [];
    let i = 0;
    while (i < src.length) {
      const c = src[i];
      if (/[\s,]/.test(c)) {
        i++;
      } else if ("()[]'".includes(c)) {
        tokens.push(c);
        i++;
      } else if (c === '"') {
        let j = i + 1;
        while (j < src.length && src[j] !== '"') {
          j += src[j] === '\\' ? 2 : 1;
        }
        if (j >= src.length) throw new Error('EOF while reading string');
        tokens.push(src.slice(i, j + 1));
        i = j + 1;
      } else if (c === ';') {
        break;
      } else {
        let j = i;
        while (j < src.length && !/[\s,()[\]"';]/.test(src[j])) j++;
        tokens.push(src.slice(i, j));
        i = j;
      }
    }
    return tokens;
  }

  function readForm(tokens: string[]): Value {
    const tok = tokens.shift();
    if (tok === undefined) throw new Error('EOF while reading');
    if (tok === "'") return [new Sym('quote'), readForm(tokens)];
    if (tok === '(' || tok === '[') {
      const close = tok === '(' ? ')' : ']';
      const items: Value[] = [];
      while (tokens[0] !== close) {
        if (tokens.length === 0) throw new Error('EOF while reading');
        items.push(readForm(tokens));
      }
      tokens.shift();
      return tok === '(' ? items : new Vec(items);
    }
    if (tok === ')' || tok === ']') {
      throw new Error(`Unmatched delimiter: ${tok}`);
    }
    if (tok.startsWith('"')) return JSON.parse(tok);
    if (tok === 'nil') return null;
    if (tok === 'true') return true;
    if (tok === 'false') return false;
    if (/^[+-]?(\d+\.?\d*|\.\d+)$/.test(tok)) return Number(tok);
    if (tok.startsWith(':')) return new Kw(tok.slice(1));
    return new Sym(tok);
  }

  function pr(v: Value): string {
    if (v === null) return 'nil';
    if (typeof v === 'string') return JSON.stringify(v);
    if (typeof v === 'function') return '#function[user/fn]';
    if (v instanceof Kw) return ':' + v.name;
    if (v instanceof Sym) return v.name;
    if (v instanceof Raw) return v.s;
    if (v instanceof Vec) return '[' + v.items.map(pr).join(' ') + ']';
    if (Array.isArray(v)) return '(' + v.map(pr).join(' ') + ')';
    return String(v);
  }

  function asNum(v: Value): number {
    if (typeof v !== 'number') {
      throw new Error(`${pr(v)} cannot be cast to java.lang.Number`);
    }
    return v;
  }

  function seqOf(v: Value): Value[] {
    if (v instanceof Vec) return v.items;
    if (Array.isArray(v)) return v;
    if (typeof v === 'string') return v.split('');
    throw new Error(`Don't know how to create ISeq from: ${pr(v)}`);
  }

  function scrollTo(id: string): Value {
    document.getElementById(id)?.scrollIntoView({ behavior: 'smooth' });
    return new Kw(id);
  }

  function applyTheme(name: string): Value {
    setTheme(name);
    const dark = name === 'dark';
    for (const id of [
      'theme-toggle-checkbox',
      'theme-toggle-mobile-checkbox',
    ]) {
      const cb = document.getElementById(id) as HTMLInputElement | null;
      if (cb) cb.checked = dark;
    }
    return new Kw(name);
  }

  const person = new Raw(
    '#user.SoftwareEngineer{:name "Jon Ramos", :since 2016, ' +
      ':stack [Clojure ClojureScript Datomic], :base "Urnieta"}',
  );

  const HELP = new Raw(
    [
      ';; this REPL is real, try:',
      ';;   (skills)          what I work with',
      ';;   (experience)      jump to experience',
      ';;   (projects)        jump to projects',
      ';;   (contact)         get in touch',
      ';;   (theme :light)    flip the lights',
      ';;   (* 6 7)           or just compute',
    ].join('\n'),
  );

  const env: Record<string, Value> = {
    jon: person,
    'software-engineer': () => person,
    help: () => HELP,
    skills: () =>
      new Vec(
        [
          'clojure',
          'clojurescript',
          'datomic',
          're-frame',
          'react',
          'astro',
          'typescript',
          'postgresql',
        ].map((s) => new Kw(s)),
      ),
    experience: () => scrollTo('experience'),
    projects: () => scrollTo('projects'),
    contact: () => scrollTo('contact'),
    theme: (t?: Value) => {
      if (t === undefined) {
        return new Kw(
          document.documentElement.getAttribute('data-theme') ?? 'dark',
        );
      }
      if (t instanceof Kw && (t.name === 'light' || t.name === 'dark')) {
        return applyTheme(t.name);
      }
      throw new Error('theme expects :light or :dark');
    },
    '+': (...xs) => xs.reduce<number>((a, b) => a + asNum(b), 0),
    '*': (...xs) => xs.reduce<number>((a, b) => a * asNum(b), 1),
    '-': (...xs) =>
      xs.length === 1
        ? -asNum(xs[0])
        : xs.slice(1).reduce<number>((a, b) => a - asNum(b), asNum(xs[0])),
    '/': (...xs) =>
      xs.slice(1).reduce<number>((a, b) => {
        if (asNum(b) === 0) throw new Error('Divide by zero');
        return a / asNum(b);
      }, asNum(xs[0])),
    mod: (a, b) => asNum(a) % asNum(b),
    inc: (x) => asNum(x) + 1,
    dec: (x) => asNum(x) - 1,
    max: (...xs) => Math.max(...xs.map(asNum)),
    min: (...xs) => Math.min(...xs.map(asNum)),
    '=': (a, b) => pr(a) === pr(b),
    '<': (a, b) => asNum(a) < asNum(b),
    '>': (a, b) => asNum(a) > asNum(b),
    '<=': (a, b) => asNum(a) <= asNum(b),
    '>=': (a, b) => asNum(a) >= asNum(b),
    not: (x) => x === false || x === null,
    str: (...xs) =>
      xs
        .map((x) => (typeof x === 'string' ? x : x === null ? '' : pr(x)))
        .join(''),
    count: (x) => seqOf(x).length,
    first: (x) => seqOf(x)[0] ?? null,
    last: (x) => seqOf(x)[seqOf(x).length - 1] ?? null,
    rest: (x) => seqOf(x).slice(1),
    reverse: (x) => seqOf(x).slice().reverse(),
    nth: (x, n) => {
      const s = seqOf(x);
      const i = asNum(n);
      if (i < 0 || i >= s.length) throw new Error('Index out of bounds');
      return s[i];
    },
    range: (n?: Value) => {
      const len = Math.min(n === undefined ? 0 : asNum(n), 100);
      return Array.from({ length: len }, (_, i) => i);
    },
    'rand-int': (n) => Math.floor(Math.random() * asNum(n)),
    'rand-nth': (x) => {
      const s = seqOf(x);
      return s[Math.floor(Math.random() * s.length)];
    },
  };

  function evalForm(form: Value): Value {
    if (form instanceof Sym) {
      if (form.name in env) return env[form.name];
      throw new Error(`Unable to resolve symbol: ${form.name} in this context`);
    }
    if (form instanceof Vec) return new Vec(form.items.map(evalForm));
    if (!Array.isArray(form)) return form;
    if (form.length === 0) return [];

    const [head, ...args] = form;
    if (head instanceof Sym) {
      if (head.name === 'quote') return args[0] ?? null;
      if (head.name === 'def') {
        const [name, expr] = args;
        if (!(name instanceof Sym)) {
          throw new Error('First argument to def must be a Symbol');
        }
        env[name.name] = expr === undefined ? null : evalForm(expr);
        return new Raw(`#'user/${name.name}`);
      }
      if (head.name === 'if') {
        const test = evalForm(args[0]);
        const branch = test === false || test === null ? args[2] : args[1];
        return branch === undefined ? null : evalForm(branch);
      }
      if (head.name === 'do') {
        return args.reduce<Value>((_, f) => evalForm(f), null);
      }
    }

    const fn = evalForm(head);
    if (typeof fn !== 'function') {
      throw new Error(`${pr(fn)} cannot be cast to clojure.lang.IFn`);
    }
    return fn(...args.map(evalForm));
  }

  /* ------------------------------- UI ------------------------------- */

  const repl = document.querySelector<HTMLElement>('.repl');
  const history = document.getElementById('repl-history');
  const input = document.getElementById(
    'repl-input',
  ) as HTMLInputElement | null;

  if (repl && history && input) {
    const MAX_LINES = 14;

    const addLine = (cls: string, text: string, prompt = false) => {
      const p = document.createElement('p');
      p.className = `repl-line ${cls}`;
      if (prompt) {
        const span = document.createElement('span');
        span.className = 'repl-prompt';
        span.textContent = 'user=>';
        p.append(span, document.createTextNode(' ' + text));
      } else {
        p.textContent = text;
      }
      history.append(p);
      while (history.children.length > MAX_LINES) {
        history.firstElementChild?.remove();
      }
    };

    const clip = (s: string) => (s.length > 280 ? s.slice(0, 280) + '…' : s);
    const fail = (err: unknown) =>
      addLine(
        'repl-err',
        `Execution error: ${err instanceof Error ? err.message : err}`,
      );

    // The built-in mini evaluator: instant, and the fallback whenever
    // SCI isn't available.
    const evalMini = (src: string) => {
      const tokens = tokenize(src);
      if (tokens.length === 0) throw new Error('EOF while reading');
      let result: Value = null;
      while (tokens.length > 0) result = evalForm(readForm(tokens));
      addLine('repl-out', clip(pr(result)));
    };

    const site = {
      scroll: (id: string) => {
        scrollTo(id);
      },
      theme: (name?: string) => {
        if (name) applyTheme(name);
        return document.documentElement.getAttribute('data-theme') ?? 'light';
      },
    };

    // Start fetching SCI as soon as someone shows intent to type.
    // loadSci loads once and caches its promise, so calling it again
    // is free.
    let sci: SciEval | null = null;
    const warmUp = () => loadSci(site).then((ev) => (sci = ev));
    input.addEventListener('focus', warmUp, { once: true });

    const past: string[] = [];
    let cursor = 0;
    let busy = false;

    input.addEventListener('keydown', async (e) => {
      if (e.key === 'Enter') {
        const src = input.value.trim();
        if (!src || busy) return;
        addLine('repl-echo', src, true);
        past.push(src);
        cursor = past.length;
        input.value = '';

        if (!sci) {
          busy = true;
          const slow = setTimeout(
            () => addLine('repl-out', ';; loading Clojure…'),
            250,
          );
          await warmUp();
          clearTimeout(slow);
          busy = false;
        }

        try {
          if (sci) {
            const { printed, value } = sci(src);
            printed.forEach((line) => addLine('repl-out', clip(line)));
            addLine('repl-out', clip(value));
          } else {
            evalMini(src);
          }
        } catch (err) {
          fail(err);
        }
      } else if (e.key === 'ArrowUp' && past.length > 0) {
        e.preventDefault();
        cursor = Math.max(0, cursor - 1);
        input.value = past[cursor];
      } else if (e.key === 'ArrowDown' && past.length > 0) {
        e.preventDefault();
        cursor = Math.min(past.length, cursor + 1);
        input.value = cursor === past.length ? '' : past[cursor];
      }
    });

    repl.addEventListener('click', () => {
      if (window.getSelection()?.toString() === '') {
        input.focus({ preventScroll: true });
      }
    });
  }
</script>

<style>
  .hero {
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }

  /* ---- the painted wall ---- */
  .wall {
    position: relative;
    background: var(--wall);
    color: var(--on-wall);
    overflow: hidden;
  }

  .wall-grid {
    display: grid;
    grid-template-columns: 1fr minmax(180px, 340px);
    grid-template-areas:
      'name  portrait'
      'intro portrait';
    column-gap: clamp(1.5rem, 4vw, 4rem);
    padding-top: clamp(2.5rem, 6vw, 5rem);
  }

  .name {
    grid-area: name;
    display: grid;
    font-size: clamp(5.5rem, 17vw, 14.5rem);
    font-weight: 900;
    font-stretch: var(--cond);
    line-height: 0.8;
    color: var(--on-wall);
    margin-left: -0.04em;
  }

  /* each line rises out of the wall once, on load */
  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.04em;
  }

  .line > span {
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .line > span {
      animation: rise 900ms var(--ease) both;
    }

    .line + .line > span {
      animation-delay: 110ms;
    }
  }

  @keyframes rise {
    from {
      transform: translateY(102%);
    }
  }

  .intro {
    grid-area: intro;
    align-self: end;
    max-width: 38rem;
    padding: clamp(1.5rem, 3vw, 2.5rem) 0 clamp(2rem, 4vw, 3rem);
  }

  .role {
    margin: 0 0 0.6rem;
    font-size: var(--step-2);
    font-weight: 700;
    font-stretch: var(--semi);
    line-height: 1.15;
    color: var(--on-wall);
  }

  .lede {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--on-wall-muted);
  }

  .lede a {
    color: var(--on-wall);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  .lede a:hover {
    text-decoration-color: var(--paint);
  }

  .portrait {
    grid-area: portrait;
    align-self: end;
    margin: 0;
    position: relative;
    z-index: 1;
    /* the photo stands on the painted line */
    margin-bottom: -1px;
  }

  .portrait img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    filter: grayscale(0.15) contrast(1.04);
  }

  .marra {
    height: 10px;
    background: var(--paint);
  }

  /* ---- two doors: who are you? ---- */
  .doors {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .door {
    display: flex;
    align-items: flex-end;
    min-height: 9rem;
    padding: 1.25rem 1.5rem;
    font-size: clamp(1.7rem, 3.4vw, 2.6rem);
    font-weight: 800;
    font-stretch: var(--cond);
    line-height: 0.98;
    text-wrap: balance;
    border: 2px solid var(--ink);
    transition:
      background-color 180ms var(--ease),
      color 180ms var(--ease);
  }

  .door-local {
    background: var(--paint);
    border-color: var(--paint);
    color: var(--on-paint);
  }

  .door-local:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--ground);
  }

  .door-tech {
    border-left: 0;
    color: var(--ink);
  }

  .door-tech:hover {
    background: var(--ink);
    color: var(--ground);
  }

  /* ---- the REPL: the only monospace on the page ---- */
  .repl {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: 1.25rem 1.5rem 1.1rem;
    background: var(--code-bg);
    color: var(--code-ink);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.7;
    cursor: text;
  }

  .repl-hint {
    margin: 0 0 0.6rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--code-dim);
  }

  .repl :global(.repl-line) {
    margin: 0;
    color: var(--code-ink);
    white-space: pre-wrap;
    word-break: break-word;
    font-family: var(--font-mono);
    line-height: 1.7;
  }

  .repl :global(.repl-prompt) {
    color: var(--code-accent);
    margin-right: 0.6ch;
  }

  .repl-result,
  .repl :global(.repl-out) {
    color: var(--code-dim) !important;
  }

  .repl :global(.repl-err) {
    color: #ff958c !important;
  }

  .repl-input-line {
    display: flex;
    align-items: baseline;
  }

  .repl-input {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--code-ink);
    font: inherit;
    caret-color: var(--code-accent);
  }

  .repl-input::placeholder {
    color: #5f7a6b;
  }

  .repl:focus-within {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  @media (max-width: 760px) {
    .wall-grid {
      grid-template-columns: 1fr 42%;
      grid-template-areas:
        'name  name'
        'intro portrait';
      column-gap: 1rem;
    }

    .name {
      font-size: clamp(5rem, 31vw, 9rem);
    }

    .intro {
      padding-bottom: 1.5rem;
    }

    .role {
      font-size: 1.25rem;
    }

    .lede {
      font-size: 1rem;
    }

    .doors {
      grid-template-columns: 1fr;
    }

    .door {
      min-height: 6.5rem;
    }

    .door-tech {
      border-left: 2px solid var(--ink);
      border-top: 0;
    }
  }
</style>
