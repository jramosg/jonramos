---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import GithubIcon from '@/assets/github.svg';
import LinkedinIcon from '@/assets/linkedin.svg';
import MailIcon from '@/assets/mail.svg';
import CoffeeIcon from '@/assets/coffee.svg';
import { buymeacoffee, github, linkedin, mail } from '@/settings';
import { getNavigationUrl } from '@/utils/navigation';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

const socials = [
  {
    icon: GithubIcon,
    href: `https://github.com/${github}`,
    label: 'GitHub',
    verb: 'Follow',
  },
  {
    icon: LinkedinIcon,
    href: `https://linkedin.com/in/${linkedin}`,
    label: 'LinkedIn',
    verb: 'Connect',
  },
  {
    icon: MailIcon,
    href: `mailto:${mail}`,
    label: 'Email',
    verb: 'Email',
  },
  {
    icon: CoffeeIcon,
    href: `https://www.buymeacoffee.com/${buymeacoffee}`,
    label: 'Buy Me a Coffee',
    verb: 'Support',
  },
];
---

<footer
  class="footer"
  role="contentinfo"
  itemscope
  itemtype="https://schema.org/WPFooter"
>
  <div class="container">
    <div class="finale">
      <p class="wordmark" aria-hidden="true">
        Jon <em>Ramos</em>
      </p>

      <a href={getNavigationUrl(lang, '#home')} class="back-to-top">
        <span class="top-arrow" aria-hidden="true">↑</span>
        {t('footer.backToTop')}
      </a>
    </div>

    <div class="content">
      <div class="footer-left">
        <p class="colophon" aria-hidden="true">
          <span class="semis">;;</span> eof — Astro · Clojure-flavoured · Urnieta
        </p>
        <p>
          <small
            >&copy; {currentYear}
            <span itemprop="copyrightHolder">Jon Ramos</span>. {
              t('footer.rights')
            }</small
          >
        </p>
        <p class="tagline">
          <small>Senior Software Engineer | Full Stack Developer</small>
        </p>
      </div>

      <nav class="social-links" aria-label="Social media links">
        {
          socials.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer me"
              class="social-icon"
              aria-label={`${social.verb} Jon Ramos on ${social.label}`}
              title={`${social.verb} Jon Ramos on ${social.label}`}
            >
              <social.icon aria-hidden="true" />
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 4.5rem 0 3rem;
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
    position: relative;
  }

  /* short teal segment over the top hairline, echoing the section entries */
  .footer::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 50%;
    transform: translateX(-50%);
    width: 72px;
    height: 2px;
    background: var(--accent);
  }

  .finale {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 3rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--hairline);
  }

  .wordmark {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-tight);
    /* a touch over 1 so italic ascenders/descenders aren't clipped */
    line-height: 1.15;
    color: var(--text-strong);
    margin: 0;
    user-select: none;
  }

  .wordmark em {
    font-style: italic;
    background: linear-gradient(105deg, var(--accent) 20%, var(--haze) 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    /* italic overhang would otherwise be clipped by background-clip: text */
    display: inline-block;
    padding-right: 0.12em;
  }

  .back-to-top {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
    padding: 0.5rem 0;
    flex-shrink: 0;
    transition: color var(--dur-base) var(--ease-out-expo);
  }

  .back-to-top:hover {
    color: var(--accent);
  }

  .top-arrow {
    transition: transform var(--dur-base) var(--ease-out-expo);
  }

  .back-to-top:hover .top-arrow {
    transform: translateY(-3px);
  }

  .content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-left {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .colophon {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    margin: 0 0 0.375rem;
  }

  .colophon .semis {
    color: var(--accent);
  }

  .footer-left p {
    color: var(--color-text);
    font-size: 0.875rem;
    margin: 0;
  }

  .tagline {
    color: var(--color-text-muted);
    font-size: 0.75rem;
    margin-top: 0.25rem;
    opacity: 1;
  }

  .social-links {
    display: flex;
    gap: 0.75rem;
  }

  .social-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--surface-overlay);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    transition: all 0.2s var(--ease-out-expo);
  }

  .social-icon:hover {
    background: var(--accent-soft);
    border-color: var(--accent-line);
    color: var(--accent);
    transform: translateY(-2px);
  }

  .social-icon :global(svg) {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 600px) {
    .finale {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .content {
      flex-direction: column;
      gap: 2rem;
      text-align: center;
    }

    .footer-left {
      align-items: center;
    }
  }
</style>
