---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { buymeacoffee, github, linkedin, mail } from '@/settings';
import { getNavigationUrl } from '@/utils/navigation';
import { localPath } from '@/data/localSlugs';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

const socials = [
  {
    href: `https://github.com/${github}`,
    label: 'GitHub',
    verb: 'Follow',
  },
  {
    href: `https://linkedin.com/in/${linkedin}`,
    label: 'LinkedIn',
    verb: 'Connect',
  },
  {
    href: `mailto:${mail}`,
    label: 'Email',
    verb: 'Email',
  },
  {
    href: `https://www.buymeacoffee.com/${buymeacoffee}`,
    label: 'Buy Me a Coffee',
    verb: 'Support',
  },
];
---

<footer class="footer" role="contentinfo">
  <div class="container">
    <p class="big" aria-hidden="true">Jon Ramos</p>
    <nav class="site-links" aria-label={t('footer.siteLinks')}>
      <a href={localPath(lang)}>{t('nav.local')}</a>
      <a href={getNavigationUrl(lang, '#projects')}>{t('nav.projects')}</a>
      <a href={`/${lang}/contributions`}>{t('nav.contributions')}</a>
      <a href={getNavigationUrl(lang, '#contact')}>{t('nav.contact')}</a>
    </nav>
    <div class="row">
      <p class="small">&copy; {currentYear} Jon Ramos. Urnieta, Gipuzkoa.</p>
      <nav class="socials" aria-label="Social links">
        {socials.map((social) => <a
          href={social.href}
          target="_blank"
          rel="noopener noreferrer me"
        >
          {social.label}
        </a>)}
      </nav>
      <a href={getNavigationUrl(lang, '#home')} class="top">
        {t('footer.backToTop')}
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--wall);
    color: var(--on-wall);
    padding: clamp(3rem, 6vw, 5rem) 0 2rem;
    border-top: 10px solid var(--paint);
    overflow: hidden;
  }

  .big {
    margin: 0 0 2rem -0.04em;
    font-size: clamp(4rem, 19vw, 17rem);
    font-weight: 900;
    font-stretch: var(--cond);
    line-height: 0.8;
    color: var(--on-wall);
    white-space: nowrap;
  }

  .site-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin-bottom: 2rem;
  }

  .site-links a {
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    font-weight: 800;
    font-stretch: var(--cond);
    color: var(--on-wall);
  }

  .site-links a:first-child {
    color: var(--paint);
  }

  .site-links a:hover {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 0.15em;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1rem 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(243, 245, 244, 0.25);
  }

  .small {
    margin: 0;
    color: var(--on-wall-muted);
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  .socials a,
  .top {
    color: var(--on-wall);
    font-weight: 600;
  }

  .socials a:hover,
  .top:hover {
    text-decoration: underline;
    text-decoration-color: var(--paint);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .top {
    margin-left: auto;
  }
</style>
