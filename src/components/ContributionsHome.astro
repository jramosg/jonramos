---
import { Image } from 'astro:assets';
import {
  projects,
  getContributionStats,
  getContributionsByTier,
} from '@/data/contributions';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

import cljKondoLogo from '@/assets/clj-kondo.png';
import calvaLogo from '@/assets/calva.png';
import logseqLogo from '@/assets/logseq.png';
import kitLogo from '@/assets/kit.png';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const stats = getContributionStats();

const projectLogos: Record<string, any> = {
  'clj-kondo': cljKondoLogo,
  Calva: calvaLogo,
  Logseq: logseqLogo,
  Kit: kitLogo,
};
---

<section
  id="contributions"
  class="section"
  aria-labelledby="contributions-title"
>
  <div class="container">
    <header class="section-head">
      <h2 id="contributions-title" class="heading">
        {t('contributions.hero.title')}
      </h2>
      <p class="sub">{t('contributions.home.subtitle')}</p>
    </header>

    <div class="tally" aria-label="Contribution statistics">
      <p>
        <strong>{stats.totalContributions}</strong>
        {t('contributions.stats.contributions')}
      </p>
      <p>
        <strong>{stats.totalProjects}</strong>
        {t('contributions.stats.projects')}
      </p>
    </div>

    <ul class="projects" itemscope itemtype="https://schema.org/ItemList">
      <meta itemprop="name" content="Open Source Contributions" />
      {
        projects.map((project) => {
          const { featured, notable } = getContributionsByTier(
            project.contributions,
          );
          const preview =
            featured.length > 0 ? featured.slice(0, 3) : notable.slice(0, 3);
          return (
            <li class="project">
              <div class="project-name">
                {projectLogos[project.name] && (
                  <Image
                    src={projectLogos[project.name]}
                    alt=""
                    class="logo"
                    width={40}
                    height={40}
                    fit="contain"
                    loading="lazy"
                  />
                )}
                <h3>{project.name}</h3>
                <span class="count">{project.contributions.length}</span>
              </div>
              <ul class="prs">
                {preview.map((c) => (
                  <li>
                    <a
                      href={c.prLink}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {c.title}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          );
        })
      }
    </ul>

    <a href={`/${lang}/contributions`} class="btn btn-ghost all">
      {t('contributions.home.viewAll')}
    </a>
  </div>
</section>

<style>
  .tally {
    display: flex;
    gap: clamp(2rem, 6vw, 5rem);
    margin-bottom: 2.5rem;
  }

  .tally p {
    display: grid;
    margin: 0;
    font-weight: 600;
    color: var(--ink-muted);
  }

  .tally strong {
    font-size: clamp(3.5rem, 8vw, 6rem);
    font-weight: 900;
    font-stretch: var(--cond);
    line-height: 0.9;
    color: var(--ink);
  }

  .projects {
    margin: 0 0 2.5rem;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--ink);
  }

  .project {
    display: grid;
    grid-template-columns: minmax(12rem, 1fr) 2fr;
    gap: 1rem clamp(1.5rem, 4vw, 4rem);
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--rule-strong);
  }

  .project-name {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    align-self: start;
  }

  .project-name h3 {
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
  }

  .logo {
    width: 2rem;
    height: 2rem;
    object-fit: contain;
  }

  .count {
    margin-left: auto;
    padding: 0.1rem 0.5rem;
    font-weight: 700;
    background: var(--ink);
    color: var(--ground);
    border-radius: 2px;
  }

  .prs {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .prs li + li {
    border-top: 1px solid var(--rule);
  }

  .prs a {
    display: block;
    padding: 0.45rem 0;
    color: var(--ink-muted);
  }

  .prs a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  @media (max-width: 760px) {
    .project {
      grid-template-columns: 1fr;
    }

    .count {
      margin-left: 0.25rem;
    }
  }
</style>
