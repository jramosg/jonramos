---
import { languages } from '@/i18n/ui';
import { getLangFromUrl, getLangPath } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const currentUrl = Astro.url;
---

<div class="language-picker">
  {
    Object.entries(languages).map(([langCode, label]) => (
      <a
        href={getLangPath(currentUrl, langCode)}
        class={`lang-link ${lang === langCode ? 'active' : ''}`}
        hreflang={langCode}
        lang={langCode}
        aria-current={lang === langCode ? 'true' : undefined}
      >
        {label}
      </a>
    ))
  }
</div>

<style>
  .language-picker {
    display: flex;
    align-items: center;
  }

  .lang-link {
    padding: 0.35rem 0.45rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-subtle);
    transition: color 160ms var(--ease);
  }

  .lang-link:hover,
  .lang-link.active {
    color: var(--ink);
  }

  .lang-link.active {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }
</style>
