---
import ExternalLinkIcon from '@/assets/icons/external-link.svg';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const publications = [
  {
    title:
      'Patient characteristics, clinical course and factors associated to ICU mortality in critically ill patients infected with SARS-CoV-2 in Spain: A prospective, cohort, multicentre study',
    journal: 'Revista Española de Anestesiología y Reanimación',
    year: '2020',
    href: 'https://pmc.ncbi.nlm.nih.gov/articles/PMC7357496/',
  },
  {
    title:
      'Awake prone positioning does not reduce the risk of intubation in COVID-19 treated with high-flow nasal oxygen therapy: a multicenter, adjusted cohort study',
    journal: 'Critical Care',
    year: '2020',
    href: 'https://pmc.ncbi.nlm.nih.gov/articles/PMC7537953/',
  },
  {
    title:
      'Early corticosteroids are associated with lower mortality in critically ill patients with COVID-19: a cohort study',
    journal: 'Critical Care',
    year: '2021',
    href: 'https://pmc.ncbi.nlm.nih.gov/articles/PMC7780210/',
  },
  {
    title:
      'High-flow nasal oxygen in patients with COVID-19-associated acute respiratory failure',
    journal: 'Critical Care',
    year: '2021',
    href: 'https://pmc.ncbi.nlm.nih.gov/articles/PMC7876530/',
  },
];
---

<section
  id="publications"
  class="section"
  aria-labelledby="publications-title"
  itemscope
  itemtype="https://schema.org/ItemList"
>
  <div class="container">
    <header class="section-head" data-reveal>
      <p class="kicker">
        <span class="no">02</span> · {t('publications.title')}
      </p>
      <div class="heading-row">
        <h2 id="publications-title" class="heading" itemprop="name">
          {t('publications.title')}
        </h2>
      </div>
      <p class="sub">{t('publications.intro')}</p>
      <meta itemprop="numberOfItems" content={String(publications.length)} />
      <meta itemprop="itemListOrder" content="ItemListUnordered" />
    </header>

    <ol class="publication-list" aria-label={t('publications.listLabel')}>
      {
        publications.map((publication, index) => (
          <li
            class="publication-item"
            itemprop="itemListElement"
            itemscope
            itemtype="https://schema.org/ListItem"
            data-reveal
            style={`--reveal-delay: ${index * 60}ms`}
          >
            <meta itemprop="position" content={String(index + 1)} />
            <article
              class="publication"
              itemprop="item"
              itemscope
              itemtype="https://schema.org/ScholarlyArticle"
            >
              <time
                class="publication-year"
                datetime={publication.year}
                itemprop="datePublished"
              >
                {publication.year}
              </time>

              <div class="publication-body">
                <h3 class="publication-title" itemprop="headline">
                  <a
                    href={publication.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    itemprop="url"
                  >
                    {publication.title}
                  </a>
                </h3>
                <p class="publication-meta">
                  <span
                    itemprop="isPartOf"
                    itemscope
                    itemtype="https://schema.org/Periodical"
                  >
                    <span itemprop="name">{publication.journal}</span>
                  </span>
                  <span class="separator" aria-hidden="true">
                    ·
                  </span>
                  <span>{t('publications.association')}</span>
                </p>
                <meta itemprop="contributor" content="Jon Ramos" />
              </div>

              <a
                class="publication-link"
                href={publication.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${t('publications.link')}: ${publication.title}`}
              >
                <span>{t('publications.link')}</span>
                <ExternalLinkIcon width={14} height={14} aria-hidden="true" />
              </a>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .section {
    padding: 5.5rem 0;
  }

  .section-head {
    margin-bottom: 2.25rem;
  }

  .section-head .heading {
    font-size: var(--text-2xl);
  }

  .section-head .sub {
    max-width: 66ch;
  }

  .publication-list {
    list-style: none;
    max-width: 980px;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--hairline-strong);
  }

  .publication-item {
    border-bottom: 1px solid var(--hairline);
  }

  .publication {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: start;
    padding: 1.35rem 0.75rem;
    margin: 0 -0.75rem;
    border-radius: var(--radius-sm);
    transition:
      background-color var(--dur-base) var(--ease-out-expo),
      border-color var(--dur-base) var(--ease-out-expo);
  }

  .publication-year {
    padding-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-wide);
    color: var(--accent);
  }

  .publication-body {
    min-width: 0;
  }

  .publication-title {
    margin: 0 0 0.55rem;
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    text-wrap: balance;
  }

  .publication-title a {
    color: var(--text-strong);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out-expo);
  }

  .publication-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    line-height: 1.55;
    color: var(--text-subtle);
  }

  .separator {
    color: var(--hairline-strong);
  }

  .publication-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.15rem;
    padding: 0.3rem 0;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-subtle);
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-out-expo);
  }

  .publication-link :global(svg) {
    transition: transform var(--dur-base) var(--ease-out-expo);
  }

  .publication-title a:focus-visible,
  .publication-link:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
    border-radius: var(--radius-xs);
  }

  @media (hover: hover) and (pointer: fine) {
    .publication:hover {
      background: var(--accent-soft);
    }

    .publication:hover .publication-title a,
    .publication-title a:hover,
    .publication-link:hover {
      color: var(--accent-hover);
    }

    .publication-link:hover :global(svg) {
      transform: translate(2px, -2px);
    }
  }

  @media (max-width: 768px) {
    .section {
      padding: 4rem 0;
    }

    .publication {
      grid-template-columns: 3.5rem minmax(0, 1fr);
      gap: 0.75rem 1rem;
      padding: 1.25rem 0.5rem;
      margin: 0 -0.5rem;
    }

    .publication-link {
      grid-column: 2;
      justify-self: start;
      margin-top: 0;
    }
  }

  @media (max-width: 480px) {
    .publication {
      grid-template-columns: 1fr;
    }

    .publication-year,
    .publication-link {
      grid-column: 1;
    }

    .publication-year {
      padding-top: 0;
    }

    .separator {
      display: none;
    }

    .publication-meta > span {
      flex-basis: 100%;
    }
  }
</style>
