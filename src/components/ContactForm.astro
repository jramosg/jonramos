---
import { useTranslations, getLangFromUrl } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<form
  class="contact-form"
  id="contact-form"
  data-msg-sending={t('contact.form.sending')}
  data-msg-success={t('contact.form.success')}
  data-msg-error={t('contact.form.error')}
>
  <input type="hidden" name="language" value={lang} />
  <div class="form-group">
    <label for="name">{t('contact.form.name')}</label>
    <input
      type="text"
      id="name"
      name="name"
      required
      autocomplete="name"
      class="form-input"
    />
  </div>

  <div class="form-group">
    <label for="email">{t('contact.form.email')}</label>
    <input
      type="email"
      id="email"
      name="email"
      required
      autocomplete="email"
      class="form-input"
    />
  </div>

  <div class="form-group">
    <label for="message">{t('contact.form.message')}</label>
    <textarea
      id="message"
      name="message"
      rows="4"
      required
      class="form-input textarea"></textarea>
  </div>

  <button type="submit" class="submit-btn btn btn-paint">
    <span class="btn-text">{t('contact.form.send')}</span>
  </button>

  <div class="form-status" id="form-status" role="status" aria-live="polite">
  </div>
</form>

<script>
  import { actions } from 'astro:actions';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('.submit-btn');
      const originalText = btn?.innerHTML;
      const { msgSending, msgSuccess, msgError } = form.dataset;

      if (btn) {
        btn.innerHTML = `<span class="loader"></span> ${msgSending}`;
        (btn as HTMLButtonElement).disabled = true;
      }

      const formData = new FormData(form);
      const { error } = await actions.submitContact(formData);

      if (status) {
        if (error) {
          status.textContent = msgError ?? 'Error sending message.';
          status.className = 'form-status error show';
        } else {
          status.textContent = msgSuccess ?? 'Message sent!';
          status.className = 'form-status success show';
          form.reset();
        }

        if (btn && originalText) {
          btn.innerHTML = originalText;
          (btn as HTMLButtonElement).disabled = false;
        }

        setTimeout(() => {
          status.className = 'form-status';
        }, 3000);
      }
    });
  }
</script>

<style>
  .contact-form {
    display: grid;
    gap: 1.25rem;
  }

  .form-group {
    display: grid;
    gap: 0.35rem;
  }

  label {
    font-weight: 600;
    color: var(--ink);
  }

  .form-input {
    width: 100%;
    padding: 0.8rem 0.9rem;
    font: inherit;
    color: var(--ink);
    background: var(--ground-raised);
    border: 2px solid var(--rule-strong);
    border-radius: 2px;
    transition: border-color 160ms var(--ease);
  }

  .form-input:hover {
    border-color: var(--ink-subtle);
  }

  .form-input:focus {
    outline: none;
    border-color: var(--ink);
  }

  .textarea {
    min-height: 9rem;
    resize: vertical;
  }

  .submit-btn {
    justify-self: start;
  }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .form-status {
    display: none;
    padding: 0.75rem 1rem;
    font-weight: 600;
    border-left: 4px solid;
  }

  .form-status.show {
    display: block;
  }

  .form-status.success {
    border-color: var(--link);
    color: var(--ink);
    background: var(--accent-soft);
  }

  .form-status.error {
    border-color: #b42318;
    color: var(--ink);
    background: rgba(180, 35, 24, 0.08);
  }

  :global(.loader) {
    width: 1em;
    height: 1em;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
