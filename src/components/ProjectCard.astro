---
interface Demo {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  href: string;
  tags: string[];
  demos?: Demo[];
}

const { title, description, href, tags, demos } = Astro.props;
// The visible address: just the host for sites, but owner/repo for
// GitHub, where the bare host says nothing about the project.
const url = new URL(href);
const host = url.hostname.replace(/^www\./, '');
const address =
  host === 'github.com' ? `${host}${url.pathname.replace(/\/$/, '')}` : host;
---

<article
  class="row"
  itemprop="item"
  itemscope
  itemtype="https://schema.org/CreativeWork"
>
  <h3 class="title" itemprop="name">
    <a href={href} target="_blank" rel="noopener noreferrer" itemprop="url">
      {title}
    </a>
  </h3>
  <div class="detail">
    <p class="description" itemprop="description">{description}</p>
    <p class="meta">
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        class="host u-link"
      >
        {address}
      </a>
      <span class="tags" itemprop="keywords">{tags.join(', ')}</span>
    </p>
    {demos && demos.length > 0 && <p class="demos">
      Demo:{' '}
      {demos.map((demo, i) => (
        <>
          {i > 0 && ', '}
          <a
            href={demo.href}
            target="_blank"
            rel="noopener noreferrer"
            class="u-link"
          >
            {demo.label}
          </a>
        </>
      ))}
    </p>}
  </div>
</article>

<style>
  .row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: 0.75rem clamp(1.5rem, 4vw, 4rem);
    padding: clamp(1.25rem, 3vw, 2rem) 0;
  }

  .title {
    font-size: clamp(2rem, 4.6vw, 3.6rem);
    line-height: 0.95;
  }

  .title a {
    background-image: linear-gradient(var(--line), var(--line));
    background-size: 0 4px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition: background-size 260ms var(--ease);
  }

  .title a:hover,
  .title a:focus-visible {
    background-size: 100% 4px;
  }

  .description {
    margin-bottom: 0.6rem;
    max-width: 60ch;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-subtle);
  }

  .host {
    font-weight: 650;
    overflow-wrap: anywhere;
  }

  .demos {
    margin: 0.5rem 0 0;
    font-size: var(--step--1);
  }

  @media (max-width: 760px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
