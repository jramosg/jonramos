---
import Footer from '@/components/Footer.astro';
import BaseLayout from './BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  alternates?: Record<'en' | 'es' | 'eu', string>;
}

const { title, description, ogImage, alternates } = Astro.props;
---

<BaseLayout {...{ title, description, ogImage, alternates }}>
  <slot name="head" slot="head" />
  <Navbar />
  <main id="main-content" tabindex="-1">
    <slot />
  </main>
  <Footer />
</BaseLayout>
