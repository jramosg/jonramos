---
import ThemeProvider from '@/components/theme-switcher/ThemeProvider.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import { github, linkedin, location, mail } from '@/settings';
import jetbrainsLatin400 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-standard-normal.woff2?url';
import archivoLatinExt from '@fontsource-variable/archivo/files/archivo-latin-ext-standard-normal.woff2?url';
import '@/styles/global.css';

type Lang = 'en' | 'es' | 'eu';

interface Crumb {
  name: string;
  path: string;
}

interface Props {
  title?: string;
  description?: string;
  /** Path under public/, e.g. /og/local-es.jpg. Defaults to the
   *  home card in the page's language. */
  ogImage?: string;
  ogImageAlt?: string;
  /** Per-language paths when a page's slug differs by language. */
  alternates?: Record<Lang, string>;
  /** Language served to visitors whose language isn't offered. */
  xDefault?: Lang;
  /** Trail after the home crumb, for BreadcrumbList. */
  breadcrumb?: Crumb[];
  noindex?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const {
  title = t('meta.title'),
  description = t('meta.description'),
  ogImage = `/og/home-${lang}.jpg`,
  ogImageAlt = `Jon Ramos. ${t('hero.title')}`,
  alternates,
  xDefault = 'en',
  breadcrumb = [],
  noindex = false,
} = Astro.props;

// Absolute URLs always use the public origin (astro.config `site`), never
// the host the request came in on, and drop query strings and trailing
// slashes so every page has exactly one canonical address.
const origin = (Astro.site ?? Astro.url).origin;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = `${origin}${path}`;

// Language-relative path ('' for /en, '/contributions' for
// /en/contributions) so hreflang points at the same page per language.
const langPath = path.replace(new RegExp(`^/${lang}`), '');
const altHref = (l: Lang) =>
  `${origin}${alternates?.[l] ?? `/${l}${langPath}`}`;
const isHome = langPath === '';

const ogLocales: Record<Lang, string> = {
  en: 'en_GB',
  es: 'es_ES',
  eu: 'eu_ES',
};
const skipLabel: Record<Lang, string> = {
  en: 'Skip to content',
  es: 'Saltar al contenido',
  eu: 'Edukira joan',
};

const person = {
  '@type': 'Person',
  '@id': `${origin}/#person`,
  name: 'Jon Ramos',
  givenName: 'Jon',
  familyName: 'Ramos',
  jobTitle: t('hero.title'),
  description: t('meta.description'),
  url: `${origin}/${lang}`,
  image: `${origin}/og/home-${lang}.jpg`,
  email: `mailto:${mail}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Urnieta',
    postalCode: '20130',
    addressRegion: 'Gipuzkoa',
    addressCountry: 'ES',
  },
  homeLocation: {
    '@type': 'Place',
    name: 'Urnieta',
    geo: {
      '@type': 'GeoCoordinates',
      latitude: location.lat,
      longitude: location.lng,
    },
  },
  worksFor: {
    '@type': 'Organization',
    name: 'Ubikare',
    url: 'https://ubikare.io/',
  },
  sameAs: [
    `https://github.com/${github}`,
    `https://www.linkedin.com/in/${linkedin}`,
  ],
  knowsLanguage: ['eu', 'es', 'en'],
  knowsAbout: [
    'Web development',
    'Web design',
    'Clojure',
    'ClojureScript',
    'Datomic',
    'TypeScript',
    'Astro',
    'React',
    'Healthcare software',
  ],
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${origin}/#website`,
  name: 'Jon Ramos',
  url: `${origin}/`,
  inLanguage: ['en', 'es', 'eu'],
  publisher: { '@id': `${origin}/#person` },
};

const page = isHome
  ? {
      '@context': 'https://schema.org',
      '@type': 'ProfilePage',
      url: canonical,
      inLanguage: lang,
      mainEntity: person,
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { name: t('nav.home'), path: `/${lang}` },
        ...breadcrumb,
      ].map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        item: `${origin}${c.path}`,
      })),
    };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && (
      <meta name="robots" content="index, follow, max-image-preview:large" />
    )}

    <!-- Preload the one face that paints the hero -->
    <link
      rel="preload"
      href={archivoLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="alternate" hreflang="en" href={altHref('en')} />
    <link rel="alternate" hreflang="es" href={altHref('es')} />
    <link rel="alternate" hreflang="eu" href={altHref('eu')} />
    <link rel="alternate" hreflang="x-default" href={altHref(xDefault)} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#eff1ef"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#0b1721"
    />
    <meta name="author" content="Jon Ramos" />

    <meta property="og:type" content={isHome ? 'profile' : 'website'} />
    <meta property="og:site_name" content="Jon Ramos" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${origin}${ogImage}`} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={ogLocales[lang]} />
    {(Object.keys(ogLocales) as Lang[])
      .filter((l) => l !== lang)
      .map((l) => (
        <meta property="og:locale:alternate" content={ogLocales[l]} />
      ))}
    {isHome && (
      <>
        <meta property="profile:first_name" content="Jon" />
        <meta property="profile:last_name" content="Ramos" />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      // Set the theme before first paint so dark visitors never see a
      // whitewash flash.
      (function () {
        var d = document.documentElement;
        d.classList.add('has-js');
        try {
          var t = localStorage.getItem('theme');
          if (!t)
            t = matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
          d.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(website)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(page)}
    />
    <Fragment
      set:html={`<style>
      @font-face {
        font-family: 'Archivo';
        font-style: normal;
        font-display: swap;
        font-weight: 100 900;
        font-stretch: 62% 125%;
        src: url('${archivoLatin}') format('woff2-variations');
        unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
      }
      @font-face {
        font-family: 'Archivo';
        font-style: normal;
        font-display: swap;
        font-weight: 100 900;
        font-stretch: 62% 125%;
        src: url('${archivoLatinExt}') format('woff2-variations');
        unicode-range: U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;
      }
      @font-face {
        font-family: 'JetBrains Mono';
        font-style: normal;
        font-display: swap;
        font-weight: 400;
        src: url('${jetbrainsLatin400}') format('woff2');
      }
      @font-face {
        font-family: 'Archivo Fallback';
        src: local('Arial'), local('Helvetica');
        size-adjust: 102%;
      }
    </style>`}
    />
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{skipLabel[lang]}</a>
    <slot />
  </body>
  <ThemeProvider />
</html>
