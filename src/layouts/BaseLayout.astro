    />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div class="background-texture" aria-hidden="true"></div>
    <div class="background-grid" aria-hidden="true"></div>
    <div class="background-aurora" aria-hidden="true"></div>
    <div class="background-grain" aria-hidden="true"></div>
    <slot />
  </body><ThemeProvider />

  <script>
    // Reveal-on-scroll: any [data-reveal] element fades/slides in once when
    // it enters the viewport. Stagger via inline `--reveal-delay`.
    const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
    if (els.length > 0 && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.08, rootMargin: '0px 0px -48px 0px' },
      );
      els.forEach((el) => io.observe(el));
    } else {
      els.forEach((el) => el.classList.add('is-revealed'));
    }

    // Cursor spotlight: cards tagged [data-spotlight] get a teal glow that
    // tracks the pointer. One delegated listener; desktop pointers only.
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      document.addEventListener(
        'pointermove',
        (e) => {
          const target = e.target as Element | null;
          const card = target?.closest?.('[data-spotlight]');
          if (card instanceof HTMLElement) {
            const r = card.getBoundingClientRect();
            card.style.setProperty('--spot-x', `${e.clientX - r.left}px`);
            card.style.setProperty('--spot-y', `${e.clientY - r.top}px`);
          }
        },
        { passive: true },
      );
    }
  </script>
</html>

<style is:global>
  /* ============================================================
     REPL Editorial — Jon Ramos Design System tokens.
     INK (warm near-black) is the signature default ground; PAPER
     (warm parchment) flips in under [data-theme='light']. The legacy
     --color-* variables are kept and remapped onto the new semantic
     tokens so every component inherits the new palette unchanged.
     ============================================================ */
  :root {
    /* ---------- Raw scales (theme-agnostic) — coastal/spa ---------- */

    /* Ink — deep navy near-blacks that harmonise with teal + haze */
    --ink-950: #0a1020;
    --ink-900: #0e1626;
    --ink-850: #131c2e;
    --ink-800: #182338;
    --ink-700: #1f2c44;
    --ink-600: #2c3a55;
    --ink-500: #4a5878;
    --ink-400: #6c7a9a;

    /* Sky — pale-blue parchment, the light ground */
    --sky-50: #f1f8fb;
    --sky-100: #e8f2f7;
    --sky-200: #d6e9f0;
    --sky-300: #b9d6e2;
    --sky-400: #94bcce;

    /* Teal — the signature lagoon (built around #31999b) */
    --teal-300: #8fd0d2;
    --teal-400: #5cb6b8;
    --teal-500: #31999b;
    --teal-600: #267879;
    --teal-700: #1c5c5d;
    --teal-800: #133f40;
    --teal-900: #082121;

    /* Haze — periwinkle secondary accent (built around #8e98c2) */
    --haze-300: #c4cae0;
    --haze-400: #a9b1d1;
    --haze-500: #8e98c2;
    --haze-600: #6e7aa6;
    --haze-700: #525d85;

    /* Shell — soft pink highlight (built around #f4bdce) */
    --shell-200: #fbdde6;
    --shell-300: #f4bdce;
    --shell-400: #ec96ae;
    --shell-500: #d96e8c;
    --shell-600: #b34d6c;
    --shell-700: #823850;

    --clay-400: #f08562;
    --clay-500: #d65b39;
    --clay-600: #b8472b;

    /* ---------- Semantic aliases — DEFAULT = INK (dark navy) ---------- */
    --surface-base: var(--ink-950);
    --surface-raised: var(--ink-900);
    --surface-sunken: #06091a;
    --surface-overlay: var(--ink-850);
    --surface-inset: var(--ink-850);

    --hairline: rgba(214, 233, 240, 0.1);
    --hairline-strong: rgba(214, 233, 240, 0.2);
    --hairline-teal: rgba(92, 182, 184, 0.3);

    --text-strong: #f1f7fb;
    --text: #dde7ee;
    --text-muted: #a3b0c4;
    --text-subtle: #7384a0;
    --text-faint: #4e5c78;

    --accent: var(--teal-400);
    --accent-hover: var(--teal-300);
    --accent-press: var(--teal-500);
    --accent-soft: rgba(92, 182, 184, 0.13);
    --accent-line: rgba(92, 182, 184, 0.32);
    --on-accent: #06181a;

    --shell: var(--shell-300);
    --shell-soft: rgba(244, 189, 206, 0.1);
    --shell-line: rgba(244, 189, 206, 0.3);

    --haze: var(--haze-400);
    --haze-soft: rgba(169, 177, 209, 0.12);
    --haze-line: rgba(169, 177, 209, 0.32);

    --clay: var(--clay-400);
    --clay-soft: rgba(240, 133, 98, 0.13);

    --focus-ring: var(--teal-400);
    --selection-bg: rgba(92, 182, 184, 0.28);

    color-scheme: dark;

    /* ---------- Type scale & weights ---------- */
    --text-2xs: 0.6875rem;
    --text-xs: 0.75rem;
    --text-sm: 0.8125rem;
    --text-base: 1rem;
    --text-md: 1.125rem;
    --text-lg: 1.375rem;
    --text-xl: 1.75rem;
    --text-2xl: 2.25rem;
    --text-3xl: clamp(2.25rem, 4.5vw, 3.25rem);
    --text-display: clamp(3.25rem, 9.5vw, 6.75rem);
    --tracking-tight: -0.02em;
    --tracking-wide: 0.04em;
    --tracking-wider: 0.14em;
    --leading-tight: 1.12;
    --leading-snug: 1.32;
    --leading-relaxed: 1.75;
    --weight-regular: 400;
    --weight-medium: 500;
    --weight-semibold: 600;
    --weight-bold: 700;

    /* ---------- Spacing, radii, elevation ---------- */
    --space-1: 0.25rem;
    --space-2: 0.5rem;
    --space-3: 0.75rem;
    --space-4: 1rem;
    --space-5: 1.5rem;
    --space-6: 2rem;
    --space-7: 2.5rem;
    --space-8: 3rem;
    --space-9: 4rem;
    --radius-xs: 3px;
    --radius-sm: 5px;
    --radius-md: 8px;
    --radius-lg: 12px;
    --radius-xl: 18px;
    --radius-pill: 999px;
    --measure: 68ch;
    --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.28);
    --shadow-md: 0 8px 24px -12px rgba(0, 0, 0, 0.55);
    --shadow-lg: 0 24px 60px -24px rgba(0, 0, 0, 0.6);
    --glow-teal:
      0 0 0 1px var(--accent-line), 0 12px 36px -16px rgba(49, 153, 155, 0.45);

    /* ---------- Typography families ---------- */
    --font-mono:
      'JetBrains Mono', 'JetBrains Mono Fallback', ui-monospace, SFMono-Regular,
      'SF Mono', Menlo, Consolas, monospace;
    --font-serif:
      'Crimson Pro Variable', 'Crimson Pro Fallback', Georgia,
      'Times New Roman', serif;

    /* ---------- Layout ---------- */
    --max-width: 1180px;
    --nav-height: 72px;

    /* ---------- Motion ---------- */
    --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-out-quint: cubic-bezier(0.22, 1, 0.36, 1);
    --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
    --dur-fast: 140ms;
    --dur-base: 240ms;
    --dur-slow: 480ms;

    /* ---------- Legacy --color-* aliases mapped to DS tokens ---------- */
    --color-bg: var(--surface-base);
    --color-bg-elevated: var(--surface-raised);
    --color-bg-surface: var(--surface-overlay);
    --color-text: var(--text-strong);
    --color-text-muted: var(--text-muted);
    --color-text-subtle: var(--text-subtle);
    --color-primary: var(--accent);
    --color-primary-muted: var(--accent-soft);
    --color-secondary: var(--haze);
