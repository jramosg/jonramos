---
export const prerender = false;

import LocalPage from '@/components/local/LocalPage.astro';
import { getLangFromUrl } from '@/i18n/utils';
import { localPath } from '@/data/localSlugs';

// This slug is the 'eu' one. Reached through another language prefix
// (e.g. the language picker), send the visitor to that language's slug.
const lang = getLangFromUrl(Astro.url);
if (lang !== 'eu') {
  return Astro.redirect(localPath(lang), 301);
}
---

<LocalPage lang="eu" />
