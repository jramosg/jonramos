---
export const prerender = false;

import LocalPage from '@/components/local/LocalPage.astro';
import { getLangFromUrl } from '@/i18n/utils';
import { localPath } from '@/data/localSlugs';

// Each language has its own slug for this page. Reached through another
// language prefix (e.g. /en/<this slug>), send the visitor to that
// language's slug.
const lang = getLangFromUrl(Astro.url);
const canonicalPath = localPath(lang);
if (Astro.url.pathname.replace(/\/$/, '') !== canonicalPath) {
  return Astro.redirect(canonicalPath, 301);
}
---

<LocalPage lang="es" />
