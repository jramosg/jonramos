# App runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=4321

# Explicit log directory inside container
# Leave unset to default to /app/logs
LOG_DIR=/app/logs

RESEND_API_KEY=re_x
CONTACT_EMAIL=your-email@example.com

# Google PageSpeed Insights key for the "measure your site" form.
# Without it the form answers that it is unavailable.
PSI_API_KEY=
